# Public site URL (used in emails, canonical URLs and the sitemap)
SITE_URL=http://localhost:3000

# Postgres connection used by all server code. In production use the Supabase pooler URL
# (Project settings > Database > Connection string > Transaction pooler, port 6543).
# Locally, `npm run db:up` starts a throwaway cluster and prints its URL.
DATABASE_URL=

# Supabase (Storage for receipts, Auth for the admin console). Service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend). When empty, emails are written to ./.data/outbox instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Crystal Royal Apartment <reservations@example.com>"

# Cloudflare Turnstile on the reserve and upload actions. When empty, the check is skipped (development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for per-IP rate limits. When empty, an in-memory limiter is used (single instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# HMAC key for the signed reserve-draft cookie and the local admin session. 32+ random characters.
DRAFT_COOKIE_SECRET=

# Development only, when Supabase Auth is not configured: password for /admin/login.
LOCAL_ADMIN_PASSWORD=
