# Public site URL (used in emails and canonical URLs)
SITE_URL=http://localhost:3000

# Data backend. "local" stores data in ./.data (development only). "supabase" uses the variables below.
DATA_BACKEND=local

# Supabase (required when DATA_BACKEND=supabase). Service-role key is server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend). When empty, emails are written to ./.data/outbox instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Crystal Royal Apartment <reservations@example.com>"
OWNER_EMAIL=

# Cloudflare Turnstile. When empty, the check is skipped (development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/expire-holds (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# HMAC key for signed draft cookies and the local admin session. 32+ random characters.
SESSION_SECRET=

# Local backend only: password for /admin/login. Ignored when DATA_BACKEND=supabase (magic link is used).
LOCAL_ADMIN_PASSWORD=
